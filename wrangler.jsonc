// Computation Model Builder: a static-assets Worker bound only to jackstanton.dev/cmb*.
// The more specific route wins over the root site's Worker (route or Custom Domain),
// so nothing outside /cmb is affected.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "computation-model-builder",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-24",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "*.jackstanton.dev/cmb*", "zone_name": "jackstanton.dev" }
  ]
}
